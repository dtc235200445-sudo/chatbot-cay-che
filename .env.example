# ============================================================
# Tea Scholar AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Môi trường: development | production ---
# Khi production, SECRET_KEY là bắt buộc (server từ chối khởi động nếu thiếu).
APP_ENV=development

# --- Security ---
# Tạo khóa ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Mặc định dùng SQLite (database/tea_scholar.db), không cần cấu hình.
# Dùng PostgreSQL có sẵn (tùy chọn, chưa được kiểm thử trong đồ án):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/tea_scholar

# --- CORS (danh sách origin cách nhau bởi dấu phẩy, mặc định là localhost) ---
# CORS_ORIGINS=http://localhost:8080,https://your-domain.example

# --- Groq LLM (OpenAI-compatible API) ---
# Nhà cung cấp LLM chính: ollama (model chạy trên máy, không cần key) hoặc groq (API, cần GROQ_API_KEY)
LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=tea-qwen2.5:3b                    # Tạo bằng: ollama create tea-qwen2.5:3b -f scripts/ollama/Modelfile.tea-3b
# OLLAMA_TIMEOUT_S=240

GROQ_API_KEY=your_groq_api_key_here
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # Default, no need to set
# GROQ_MAX_RETRIES=4                             # Số lần tự thử lại khi mất kết nối thoáng qua
# GROQ_TIMEOUT_S=45                               # Thời gian chờ tối đa cho một lần gọi (giây)
# GROQ_MAX_TOKENS=1200                            # Giới hạn token đầu ra (model suy luận tính cả token suy nghĩ)
# GROQ_REASONING_EFFORT=medium                    # Mức suy luận cho model gpt-oss: low | medium | high (rỗng = tắt)
# GROQ_MODEL=openai/gpt-oss-120b                 # Mặc định. Groq có thể ngừng cung cấp model; xem danh sách bằng GET {GROQ_BASE_URL}/models

# --- Nhà cung cấp dự phòng (tùy chọn): thử theo thứ tự khi Groq hết hạn mức hoặc lỗi ---
# Định dạng "nhà_cung_cấp:tên_model", cách nhau bằng dấu phẩy. Hỗ trợ: gemini, cerebras, openrouter, mistral, nvidia.
# Mỗi nhà cung cấp cần đúng MỘT key riêng bên dưới (thiếu key thì mục đó bị bỏ qua). Tên model phải lấy từ trang của nhà cung cấp.
# LLM_FALLBACKS=gemini:<model>,cerebras:<model>
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=

# --- RAG Tuning ---
# RAG_EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder  # Model embedding (đổi thì phải chạy lại: python -m rag.ingest và hiệu chỉnh ngưỡng)
# RAG_MIN_COSINE=0.38                             # Ngưỡng cosine tối thiểu để coi câu hỏi thuộc cơ sở tri thức (hiệu chỉnh cho model bkai)
# RAG_MIN_BM25=10.0                               # Ngưỡng BM25 tối thiểu (xem docs/RAG_EVALUATION.md)

# --- Weather (Open-Meteo, no API key required) ---
# WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast  # Default
